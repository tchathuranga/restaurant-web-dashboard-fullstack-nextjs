# Copy to .env.local and fill in. Never commit .env.local.

# MariaDB / MySQL. URL-encode special characters in the password.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DATABASE?connection_limit=3"

# Cloudinary (image storage)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Dashboard login
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
# Random string, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
